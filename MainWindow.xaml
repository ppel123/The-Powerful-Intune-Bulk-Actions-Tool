<Window x:Class="IntuneTool.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IntuneTool"
        mc:Ignorable="d"
        Title="The Powerful Intune Bulk Actions Tool" HorizontalAlignment="Stretch" Margin="0,0,0,0" VerticalAlignment="Stretch" Height="600" Width="1050">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="291*"/>
            <ColumnDefinition Width="34*"/>
            <ColumnDefinition Width="8*"/>
            <ColumnDefinition Width="41*"/>
            <ColumnDefinition Width="67*"/>
            <ColumnDefinition Width="306*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl x:Name="MainTabControl" Grid.ColumnSpan="6" Grid.Row="0">
            <TabItem x:Name="MainTab" Header="Main Tab" AutomationProperties.Name="MainTab">
                <Grid Background="#FFE5E5E5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Left Column: Image and Buttons -->
                    <StackPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" Margin="10">
                        <Image x:Name="MainImage" Height="120" Width="120" Source="/MainImage.png" Stretch="Uniform" HorizontalAlignment="Center"/>
                        <Button x:Name="SignInButtonCopy" Content="Sign-In HERE FIRST" Height="53" Margin="0,20,0,10" FontSize="18" FontWeight="Bold" FontFamily="Bahnschrift" ToolTip="Connect to Microsoft Graph with your credentials to access Intune data"/>
                        <Button x:Name="DisconnectBtn" Content="Disconnect" Height="53" Margin="0,0,0,20" FontSize="18" FontWeight="Bold" FontFamily="Bahnschrift" ToolTip="Disconnect from Microsoft Graph and clear session"/>
                        <Label x:Name="NotConnectedLabel" Content="Not Connected Yet" FontWeight="Bold" Foreground="#FFE62020" FontSize="18" HorizontalContentAlignment="Center"/>
                        <StackPanel x:Name="ConnectedPanel" Visibility="Collapsed" HorizontalAlignment="Center">
                            <Label x:Name="Connected" Content="Connected" Foreground="#FF2BFF00" FontSize="18" FontWeight="Bold" HorizontalContentAlignment="Center"/>
                            <TextBlock x:Name="LastSyncTimeLabel" Text="" FontSize="11" Foreground="#FF666666" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Right Column: Title and Text -->
                    <Label Grid.Column="1" Grid.Row="0" Content="The Powerful Intune Bulk Actions Tool" Margin="10,10,10,5" FontSize="20" HorizontalContentAlignment="Center" FontWeight="Bold" VerticalAlignment="Top"/>
                    <TextBlock x:Name="MainTextBox" Grid.Column="1" Grid.Row="1" Margin="10,5,10,10" TextWrapping="Wrap" FontSize="15" VerticalAlignment="Top">
                        <Run Text="The Powerful Intune Bulk Actions Tool is here to help every Intune administrator to effectively manage endpoints by automating various reporting and administrative tasks."/>
                        <LineBreak/><LineBreak/>

                        <Run FontWeight="Bold" Text="📊 Reporting Tab"/>
                        <LineBreak/>
                        <Run Text="Open the "/>
                        <Run FontWeight="Bold" Text="Reporting Tab"/>
                        <Run Text=" to run device reports — including device info, BitLocker status, compliance, group membership, OS distribution, detected apps, and more. Results can be exported to CSV."/>
                        <LineBreak/><LineBreak/>

                        <Run FontWeight="Bold" Text="⚡ Actions Tab"/>
                        <LineBreak/>
                        <Run Text="Open the "/>
                        <Run FontWeight="Bold" Text="Actions Tab"/>
                        <Run Text=" to perform bulk administrative actions — such as importing or removing devices from groups, retiring devices, updating Autopilot group tags, renaming devices, removing Android apps, and deleting device records."/>
                        <LineBreak/><LineBreak/>

                        <Run FontWeight="Bold" Text="📄 Session Logs"/>
                        <LineBreak/>
                        <Run Text="A log file is automatically created for every session under "/>
                        <Run FontWeight="Bold" Text="C:\Temp\YYYYMMDD\"/>
                        <Run Text=" with the naming convention "/>
                        <Run FontWeight="Bold" Text="IntuneTool_YYYYMMDD_HHmmss.log"/>
                        <Run Text="."/>
                        <LineBreak/><LineBreak/>

                        <Run FontWeight="Bold" Text="📋 Activity Log"/>
                        <LineBreak/>
                        <Run Text="The "/>
                        <Run FontWeight="Bold" Text="Activity Log"/>
                        <Run Text=" panel at the bottom of the window shows a live feed of all operations and events during your session. Click the panel header to expand or collapse it."/>
                    </TextBlock>
                </Grid>
            </TabItem>
            <TabItem x:Name="ReportingTab" HorizontalAlignment="Center" Height="20" Header="Reporting Tab" VerticalAlignment="Top" Width="86" Margin="0,-1,0,0">
                <Grid Background="#FFE5E5E5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Busy Overlay (covers entire tab) -->
                    <Border x:Name="BusyOverlay" Grid.ColumnSpan="2" Grid.RowSpan="9" Background="#80000000" Visibility="Collapsed" Panel.ZIndex="100">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ProgressBar x:Name="BusyProgressBar" IsIndeterminate="True" Width="200" Height="20" Margin="0,0,0,10"/>
                            <TextBlock x:Name="BusyStatusText" Text="Working..." FontSize="16" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <Button x:Name="ForceStopReportButton" Content="&#x26D4; Force Stop" Height="40" Width="140" Margin="0,15,0,0" FontSize="14" FontWeight="Bold" FontFamily="Bahnschrift" Background="#FFD32F2F" Foreground="White" HorizontalContentAlignment="Center" Cursor="Hand" ToolTip="Force stop the currently running operation"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Left Column: Image and Button -->
                    <StackPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="9" VerticalAlignment="Top">
                        <Image x:Name="MainImageCopy" Height="80" Width="80" Margin="10" Source="/MainImage.png" Stretch="Uniform" HorizontalAlignment="Center"/>
                        <Button x:Name="GenerateReportButton" Content="Generate&#xD;&#xA;Report" Height="72" Width="96" Margin="10,5,10,10" FontSize="18" FontWeight="Bold" FontFamily="Bahnschrift" HorizontalContentAlignment="Center" HorizontalAlignment="Center" ToolTip="Execute the selected report with the specified parameters"/>
                    </StackPanel>
                    
                    <!-- Right Column: Controls -->
                    <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Vertical" Margin="10,10,10,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label x:Name="SelectReport" Grid.Column="0" Content="Select Report:" FontSize="18" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ReportType" Grid.Column="1" FontSize="18" VerticalAlignment="Center" Margin="10,0,0,0" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <TextBlock x:Name="ReportDescriptionLabel" Text="" FontSize="13" Foreground="#FF0066CC" TextWrapping="Wrap" Margin="5,2,10,0" FontStyle="Italic" Visibility="Collapsed"/>
                    </StackPanel>
                    
                    <Grid x:Name="Row1ReportingPanel" Grid.Column="1" Grid.Row="1" Margin="10,2,10,2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="SelectSingleOrMultiple" Grid.Column="0" Content="Report for single device or multiple devices?" FontSize="18" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SingleOrMultipleDevices" Grid.Column="1" FontSize="18" VerticalAlignment="Center" Margin="10,0,0,0" HorizontalAlignment="Stretch"/>
                    </Grid>
                    
                    <Grid x:Name="Row2ReportingPanel" Grid.Column="1" Grid.Row="2" Margin="10,2,10,2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="SingleDevice" Grid.Column="0" Content="Single device (enter info):" FontSize="18" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SingleDeviceInfoChoice" Grid.Column="1" FontSize="18" VerticalAlignment="Center" Margin="10,0,10,0" HorizontalAlignment="Stretch"/>
                        <TextBox x:Name="SingleDeviceInfoBox" Grid.Column="2" Height="30" FontSize="18" TextWrapping="Wrap" Text="" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Grid>
                    
                    <Grid x:Name="Row3ReportingPanel" Grid.Column="1" Grid.Row="3" Margin="10,2,10,2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Label x:Name="MultipleDevices" Grid.Column="0" Grid.Row="0" Content="Multiple devices:&#xD;&#xA;(select a .txt/.csv&#xD;&#xA;file or paste IDs&#xD;&#xA;below)" FontSize="18" VerticalAlignment="Center"/>
                        <ComboBox x:Name="MultipleDevicesInfoChoice" Grid.Column="1" Grid.Row="0" FontSize="18" VerticalAlignment="Center" Margin="10,0,10,0" HorizontalAlignment="Stretch"/>
                        <TextBox x:Name="MultipleDevicesInfoBox" Grid.Column="2" Grid.Row="0" Height="30" FontSize="18" TextWrapping="Wrap" Text="" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                        <TextBlock x:Name="DeviceCountLabel" Grid.Column="3" Grid.Row="0" Text="" FontSize="14" Foreground="#FF2196F3" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold"/>
                        <Label Grid.Column="0" Grid.Row="1" Content="Or paste IDs here&#xD;&#xA;(one per line):" FontSize="14" VerticalAlignment="Top" Margin="0,5,0,0"/>
                        <TextBox x:Name="PastedDevicesTextBox" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="3" Height="80" FontSize="14" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" Text="" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="10,5,0,5" ToolTip="Paste device IDs here, one per line. If a file is also selected above, the file takes priority."/>
                    </Grid>
                    
                    <Grid x:Name="Row4ReportingPanel" Grid.Column="1" Grid.Row="4" Margin="10,2,10,2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="GroupInputLabelReporting" Grid.Column="0" Content="Group (Name or Object ID):" FontSize="18" VerticalAlignment="Center"/>
                        <TextBox x:Name="GroupInputBoxReporting" Grid.Column="1" Height="30" FontSize="18" TextWrapping="Wrap" Text="" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Grid>
                    
                    <Grid x:Name="Row5ReportingPanel" Grid.Column="1" Grid.Row="5" Margin="10,2,10,2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="PolicyIDLabel" Grid.Column="0" Content="Policy ID (GUID):" FontSize="18" VerticalAlignment="Center"/>
                        <TextBox x:Name="PolicyIDBox" Grid.Column="1" Height="30" FontSize="18" TextWrapping="Wrap" Text="" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Grid>
                    
                    <Label x:Name="PostRequestNote" Grid.Column="1" Grid.Row="5" Content="ℹ️ Note: This report uses a POST request to fetch data (read-only, no changes made)." FontSize="12" Foreground="#FF0066CC" Visibility="Collapsed" Margin="10,35,10,0" VerticalAlignment="Top"/>
                    
                    <Grid x:Name="Row6ReportingPanel" Grid.Column="1" Grid.Row="6" Margin="10,2,10,2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="PlatformSelectLabel" Grid.Column="0" Content="Select Platform:" FontSize="18" VerticalAlignment="Center"/>
                        <ComboBox x:Name="PlatformSelectCombo" Grid.Column="1" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="10,0,0,0">
                            <ComboBoxItem Content="Windows"/>
                            <ComboBoxItem Content="Android"/>
                            <ComboBoxItem Content="iOS"/>
                            <ComboBoxItem Content="macOS"/>
                        </ComboBox>
                    </Grid>
                    
                    <Grid x:Name="Row7ReportingPanel" Grid.Column="1" Grid.Row="7" Margin="10,2,10,2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="AppSelectLabel" Grid.Column="0" Content="Select App:" FontSize="18" VerticalAlignment="Center"/>
                        <ComboBox x:Name="AppSelectCombo" Grid.Column="1" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="10,0,0,0"/>
                    </Grid>
                    
                    <Grid Grid.Column="1" Grid.Row="8" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ListView x:Name="listview" Grid.Row="0" d:ItemsSource="{d:SampleData ItemCount=5}" Visibility="Collapsed">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                            <Button x:Name="CopyReportButton" Content="📋 Copy" Width="80" Height="30" FontSize="14" FontWeight="Bold" Margin="0,0,10,0" Visibility="Collapsed" ToolTip="Copy results to clipboard as tab-separated text"/>
                            <Button x:Name="ExportReportButton" Content="Export to CSV" Width="120" Height="30" FontSize="14" FontWeight="Bold" Visibility="Collapsed" ToolTip="Export results to a CSV file for use in Excel"/>
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="ResultsTextBox" Grid.Column="1" Grid.Row="8" Margin="10" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Visibility="Collapsed"/>
                </Grid>
            </TabItem>
            <TabItem HorizontalAlignment="Center" Height="20" Header="Actions Tab" VerticalAlignment="Top" Width="81" Margin="0,-1,0,0">
                <Grid Background="#FFE5E5E5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Busy Overlay (covers entire tab) -->
                    <Border x:Name="BusyOverlayAction" Grid.ColumnSpan="2" Grid.RowSpan="9" Background="#80000000" Visibility="Collapsed" Panel.ZIndex="100">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ProgressBar x:Name="BusyProgressBarAction" IsIndeterminate="True" Width="200" Height="20" Margin="0,0,0,10"/>
                            <TextBlock x:Name="BusyStatusTextAction" Text="Working..." FontSize="16" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <Button x:Name="ForceStopActionButton" Content="&#x26D4; Force Stop" Height="40" Width="140" Margin="0,15,0,0" FontSize="14" FontWeight="Bold" FontFamily="Bahnschrift" Background="#FFD32F2F" Foreground="White" HorizontalContentAlignment="Center" Cursor="Hand" ToolTip="Force stop the currently running operation"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Left Column: Image and Button -->
                    <StackPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="9" VerticalAlignment="Top">
                        <Image x:Name="MainImageCopy1" Height="80" Width="80" Margin="10" Source="/MainImage.png" Stretch="Uniform" HorizontalAlignment="Center"/>
                        <Button x:Name="PerformActionButton" Content="Perform&#xD;&#xA;Action" Height="72" Width="96" Margin="10,5,10,10" FontSize="18" FontWeight="Bold" FontFamily="Bahnschrift" HorizontalContentAlignment="Center" HorizontalAlignment="Center" ToolTip="Execute the selected action with the specified parameters"/>
                    </StackPanel>
                    
                    <!-- Right Column: Controls -->
                    <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Vertical" Margin="10,10,10,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label x:Name="SelectAction" Grid.Column="0" Content="Select Action:" FontSize="18" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ActionType" Grid.Column="1" FontSize="18" VerticalAlignment="Center" Margin="10,0,0,0" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <TextBlock x:Name="ActionDescriptionLabel" Text="" FontSize="13" Foreground="#FF0066CC" TextWrapping="Wrap" Margin="5,2,10,0" FontStyle="Italic" Visibility="Collapsed"/>
                    </StackPanel>
                    
                    <Grid x:Name="Row1ActionPanel" Grid.Column="1" Grid.Row="1" Margin="10,2,10,2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="SelectSingleOrMultipleAction" Grid.Column="0" Content="Action for single device or multiple devices?" FontSize="18" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SingleOrMultipleDevicesAction" Grid.Column="1" FontSize="18" VerticalAlignment="Center" Margin="10,0,0,0" HorizontalAlignment="Stretch"/>
                    </Grid>
                    
                    <Grid x:Name="Row2ActionPanel" Grid.Column="1" Grid.Row="2" Margin="10,2,10,2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="SingleDeviceAction" Grid.Column="0" Content="Single device (enter info):" FontSize="18" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SingleDeviceInfoChoiceAction" Grid.Column="1" FontSize="18" VerticalAlignment="Center" Margin="10,0,10,0" HorizontalAlignment="Stretch"/>
                        <TextBox x:Name="SingleDeviceInfoBoxAction" Grid.Column="2" Height="30" FontSize="18" TextWrapping="Wrap" Text="" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Grid>
                    
                    <Grid x:Name="Row3ActionPanel" Grid.Column="1" Grid.Row="3" Margin="10,2,10,2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Label x:Name="MultipleDevicesAction" Grid.Column="0" Grid.Row="0" Content="Multiple devices:&#xA;(select a .txt or .csv&#xA;file with one ID per line&#xA;or paste IDs below)" FontSize="18" VerticalAlignment="Center"/>
                        <ComboBox x:Name="MultipleDevicesInfoChoiceAction" Grid.Column="1" Grid.Row="0" FontSize="18" VerticalAlignment="Center" Margin="10,0,10,0" HorizontalAlignment="Stretch"/>
                        <TextBox x:Name="MultipleDevicesInfoBoxAction" Grid.Column="2" Grid.Row="0" Height="30" FontSize="18" TextWrapping="Wrap" Text="" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                        <TextBlock x:Name="DeviceCountLabelAction" Grid.Column="3" Grid.Row="0" Text="" FontSize="14" Foreground="#FF2196F3" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold"/>
                        <Label Grid.Column="0" Grid.Row="1" Content="Or paste IDs here&#xA;(one per line):" FontSize="14" VerticalAlignment="Top" Margin="0,5,0,0"/>
                        <TextBox x:Name="PastedDevicesTextBoxAction" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="3" Height="80" FontSize="14" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" Text="" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="10,5,0,5" ToolTip="Paste device IDs here, one per line. If a file is also selected above, the file takes priority."/>
                    </Grid>
                    
                    <Grid x:Name="Row4ActionPanel" Grid.Column="1" Grid.Row="4" Margin="10,2,10,2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="GroupInputLabel" Grid.Column="0" Content="Group (Name or Object ID):" FontSize="18" VerticalAlignment="Center"/>
                        <TextBox x:Name="GroupInputBox" Grid.Column="1" Height="30" FontSize="18" TextWrapping="Wrap" Text="" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Grid>
                    
                    <Grid x:Name="Row5ActionPanel" Grid.Column="1" Grid.Row="5" Margin="10,2,10,2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="GroupTagLabel" Grid.Column="0" Content="New Group Tag:" FontSize="18" VerticalAlignment="Center"/>
                        <TextBox x:Name="GroupTagBox" Grid.Column="1" Height="30" FontSize="18" TextWrapping="Wrap" Text="" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Grid>

                    <Grid x:Name="RenameOptionsPanel" Grid.Column="1" Grid.Row="6" Margin="10,2,10,2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="Auto" MinWidth="60"/>
                             <ColumnDefinition Width="*" />
                             <ColumnDefinition Width="Auto" MinWidth="90"/>
                             <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="Prefix:" FontSize="18" VerticalAlignment="Center"/>
                        <TextBox x:Name="RenamePrefixBox" Grid.Column="1" Height="30" FontSize="18" Text="" VerticalAlignment="Center" Margin="0,0,10,0" HorizontalAlignment="Stretch"/>
                        <Label x:Name="RenamePlatformLabel" Grid.Column="2" Content="Platform:" FontSize="18" VerticalAlignment="Center"/>
                        <ComboBox x:Name="RenamePlatformCombo" Grid.Column="3" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="All"/>
                            <ComboBoxItem Content="Windows"/>
                            <ComboBoxItem Content="Android"/>
                            <ComboBoxItem Content="iOS"/>
                            <ComboBoxItem Content="macOS"/>
                        </ComboBox>
                    </Grid>

                    <Grid x:Name="RowAppSelectionPanel" Grid.Column="1" Grid.Row="7" Margin="10,2,10,2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="AndroidAppLabel" Grid.Column="0" Content="Select Android App:" FontSize="18" VerticalAlignment="Center"/>
                        <ComboBox x:Name="AndroidAppCombo" Grid.Column="1" FontSize="18" VerticalAlignment="Center" Margin="10,0,0,0" HorizontalAlignment="Stretch"/>
                    </Grid>

                    <Grid x:Name="RowDeleteOptionsPanel" Grid.Column="1" Grid.Row="4" Margin="10,2,10,2" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,5,0,5">
                            <Label Content="Delete from:" FontSize="16" FontWeight="Bold" Foreground="#FF8B0000" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <CheckBox x:Name="DeleteIntuneCheckbox" Content="Intune" FontSize="14" VerticalAlignment="Center" Margin="0,0,15,0" IsChecked="True"/>
                            <CheckBox x:Name="DeleteAutopilotCheckbox" Content="Autopilot" FontSize="14" VerticalAlignment="Center" Margin="0,0,15,0" IsChecked="True"/>
                            <CheckBox x:Name="DeleteEntraCheckbox" Content="Entra ID" FontSize="14" VerticalAlignment="Center" Margin="0,0,20,0" IsChecked="True"/>
                            <Border BorderBrush="#FF8B0000" BorderThickness="1" CornerRadius="3" Padding="5,2">
                                <CheckBox x:Name="WhatIfModeCheckbox" Content="WhatIf Mode (Dry Run - No actual deletion)" FontSize="14" FontWeight="Bold" Foreground="#FF006400" VerticalAlignment="Center" IsChecked="True"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="⚠️ WARNING: This action PERMANENTLY DELETES device records and CANNOT be undone! Keep 'WhatIf Mode' checked to preview changes first." 
                                   FontSize="12" Foreground="#FF8B0000" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    </Grid>
                    
                    <Grid Grid.Column="1" Grid.Row="8" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ListView x:Name="listviewAction" Grid.Row="0" Visibility="Collapsed">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                            <Button x:Name="CopyActionButton" Content="📋 Copy" Width="80" Height="30" FontSize="14" FontWeight="Bold" Margin="0,0,10,0" Visibility="Collapsed" ToolTip="Copy results to clipboard as tab-separated text"/>
                            <Button x:Name="ExportActionButton" Content="Export to CSV" Width="120" Height="30" FontSize="14" FontWeight="Bold" Visibility="Collapsed" ToolTip="Export results to a CSV file for use in Excel"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Expander x:Name="ActivityLogExpander" Grid.Row="1" Grid.ColumnSpan="6" Header="Activity Log" Margin="4,0,4,4" IsExpanded="False">
            <ListView x:Name="LvActivityLog" Height="150" MaxHeight="200" VirtualizingPanel.IsVirtualizing="True">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Time" DisplayMemberBinding="{Binding Time}" Width="165"/>
                        <GridViewColumn Header="Level" DisplayMemberBinding="{Binding Level}" Width="65"/>
                        <GridViewColumn Header="Message" DisplayMemberBinding="{Binding Message}" Width="750"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Expander>

    </Grid>
</Window>
